# Production build env (loaded automatically by Vite on `npm run build`).
# `npm run dev` continues to use .env.local instead.
# The Clerk *publishable* key is client-safe by design, so committing it is fine.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudGlwc3l0cmFja2VyLm9yZyQ
# Empty base: all authedFetch() calls already include the "/api" prefix, and the
# backend is served same-origin at tipsytracker.org/api/*. A non-empty value here
# would double the prefix (e.g. /api/api/...).
VITE_API_BASE_URL=
