# Local development env for the frontend (Vite).
# Copy to `.env.local` (gitignored) and fill in real values.
# These VITE_* values are compiled into the static bundle at build time.

# Clerk publishable (client-safe) key from your Clerk dashboard.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Base URL the SPA prepends to API calls.
# Local dev: point at the local backend Worker (wrangler dev), e.g. http://localhost:8787
# Production: "/api" (same-origin backend served at tipsytracker.org/api/*)
VITE_API_BASE_URL=http://localhost:8787
